# Copy to .env and fill in. Never commit the real file.

PORT=3000

# Transactions need a replica set. Atlas gives you one; a standalone local
# mongod will fail on startSession. For local dev: mongod --replSet rs0,
# then rs.initiate() in mongosh.
MONGO_URL=mongodb://localhost:27017/payflow

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
